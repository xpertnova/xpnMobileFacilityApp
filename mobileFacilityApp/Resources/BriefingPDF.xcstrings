    "declaration.one" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dieser Einweisung werden standort- und betriebsspezifische Gegebenheiten, Regelungen und Hinweise zu konkreten Arbeitsbedingungen vermittelt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This briefing communicates site-specific conditions, rules, and guidance for the actual work conditions."
          }
        }
      }
    },
    "declaration.three" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Partnerfirma hält während der Arbeiten die maßgeblichen Vorschriften und Regeln zum Arbeits- und Gesundheitsschutz ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The partner company complies with all applicable occupational health and safety requirements while performing the work."
          }
        }
      }
    },
    "declaration.two" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Eingewiesene unterweist die eingesetzten Mitarbeitenden und gegebenenfalls Subunternehmer vor Beginn der Arbeiten über die Inhalte dieser Einweisung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before work begins, the instructed person briefs the assigned workers and any subcontractors on the content of this briefing."
          }
        }
      }
    },
