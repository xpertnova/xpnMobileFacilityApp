    "sap.refresh.details.forbiddenExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SAP hat die Anfrage zur Prüfung der Zugangsdaten abgelehnt, bevor die Synchronisierung begann. Die App verwendet dafür die bei der App-Anmeldung eingegebene Mitarbeiter-ID und das separate SAP-Synchronisierungspasswort. Wenn beides korrekt ist, muss der SAP-Zugang geprüft werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SAP rejected the credential-verification request before synchronization began. The app uses the worker ID entered at app login and the separate SAP synchronization password. If both are correct, SAP access needs to be checked."
